includes:
    - .Build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - .Build/vendor/phpstan/phpstan-phpunit/extension.neon
    - .Build/vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 10
    paths:
        - Classes
        - Configuration
        - Tests
    treatPhpDocTypesAsCertain: false
    # phpoffice/phpspreadsheet is a SUGGESTED dependency, so the XlsxExtractor
    # ignores below match only when it is absent. Reporting the unmatched ones
    # would make the analysis fail on whichever of the two installs it is run
    # against — which is the opposite of what an optional dependency means.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: class.notFound
            path: Classes/Document/Extractor/XlsxExtractor.php
        -
            identifier: method.nonObject
            path: Classes/Document/Extractor/XlsxExtractor.php
        -
            identifier: foreach.nonIterable
            path: Classes/Document/Extractor/XlsxExtractor.php
        -
            identifier: cast.string
            path: Classes/Document/Extractor/XlsxExtractor.php
        -
            identifier: argument.type
            path: Classes/Document/Extractor/XlsxExtractor.php

        # RunOutcomeMapper matches every AgentRunOutcome case AND keeps a default
        # arm. Against today's enum the last explicit arm makes the default
        # unreachable, and PHPStan is right to say so — but nr-llm states
        # outright that outcomes may be added in a minor release, and the default
        # arm is what turns that from a crash into a sanitized failure. The
        # redundancy is the feature.
        -
            identifier: match.alwaysTrue
            path: Classes/Service/RunOutcomeMapper.php
        -
            identifier: match.unreachable
            path: Classes/Service/RunOutcomeMapper.php
