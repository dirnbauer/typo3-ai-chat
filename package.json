{
  "name": "webconsulting_ai_chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend and test tooling for Webconsulting TYPO3 AI Chat",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test:js": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:e2e": "npx playwright test --config=Build/tests/playwright/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config=Build/tests/playwright/playwright.config.ts --headed",
    "test:e2e:report": "npx playwright show-report"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.16",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "@playwright/test": "^1.58.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "vite": "^8.1.5"
  }
}
