{
  "name": "webconsulting-typo3-ai-chat",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The <wc-ai-chat> bundle: one React/shadcn surface for the TYPO3 AI Chat panel and module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "vite build --config Build/Frontend/vite.config.ts",
    "dev": "vite build --watch --mode development --config Build/Frontend/vite.config.ts",
    "test": "vitest run --config Build/Frontend/vitest.config.ts",
    "test:watch": "vitest --config Build/Frontend/vitest.config.ts",
    "lint": "tsc --noEmit -p Build/Frontend/tsconfig.json && eslint --config Build/Frontend/eslint.config.js Build/Frontend/src Resources/Public/JavaScript/toolbar"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
