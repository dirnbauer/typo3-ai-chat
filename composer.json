{
    "name": "webconsulting/typo3-ai-chat",
    "description": "Governed AI operator chat for the TYPO3 backend: nr-llm agent runs driving in-process TYPO3 MCP tools",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "AI",
        "chat",
        "MCP",
        "LLM",
        "backend"
    ],
    "authors": [
        {
            "name": "Webconsulting",
            "homepage": "https://github.com/dirnbauer",
            "role": "Maintainer"
        },
        {
            "name": "Netresearch DTT GmbH",
            "homepage": "https://www.netresearch.de/",
            "role": "Original nr-mcp-agent authors — with our sincere thanks"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-ai-chat",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-ai-chat/issues",
        "source": "https://github.com/dirnbauer/typo3-ai-chat"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-mcp-server.git",
            "only": [
                "hn/typo3-mcp-server"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-abilities.git",
            "only": [
                "webconsulting/typo3-abilities"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/sg_apicore.git",
            "only": [
                "sgalinski/sg-apicore"
            ]
        }
    ],
    "require": {
        "php": "^8.4",
        "hn/typo3-mcp-server": "^0.7 || dev-main",
        "netresearch/nr-llm": "^0.34",
        "phpoffice/phpword": "^1.0",
        "smalot/pdfparser": "^2.0",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.4 || ^13.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.5"
    },
    "suggest": {
        "phpoffice/phpspreadsheet": "^3.0 — Required for XLSX attachment text extraction"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\Typo3AiChat\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\Typo3AiChat\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "platform": {
            "php": "8.4.0"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "webconsulting_ai_chat",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml",
        "ci:tests:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml --testsuite unit",
        "ci:tests:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml --testsuite functional",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    }
}
