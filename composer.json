{
    "name": "webconsulting/typo3-ai-chat",
    "description": "Modern governed AI operator chat for TYPO3, built with nr-llm, MCP and optional Flue workflows",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "AI",
        "chat",
        "MCP",
        "LLM",
        "backend"
    ],
    "authors": [
        {
            "name": "Webconsulting",
            "homepage": "https://github.com/dirnbauer",
            "role": "Maintainer"
        },
        {
            "name": "Netresearch DTT GmbH",
            "homepage": "https://www.netresearch.de/",
            "role": "Original nr-mcp-agent authors — with our sincere thanks"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-ai-chat",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-ai-chat/issues",
        "source": "https://github.com/dirnbauer/typo3-ai-chat"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "netresearch/nr-llm": "^0.25",
        "phpoffice/phpword": "^1.0",
        "smalot/pdfparser": "^2.0",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-core": "^13.4 || ^14.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.0",
        "captainhook/hook-installer": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "infection/infection": "^0.29 || ^0.34",
        "phpat/phpat": "^0.12",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "suggest": {
        "netresearch/nr-vault": "For secure API key storage (^0.4)",
        "hn/typo3-mcp-server": "For TYPO3 content management tools (^1.0)",
        "webconsulting/flue": "For durable, draft-workspace TYPO3 agent workflows",
        "phpoffice/phpspreadsheet": "^3.0 — Required for XLSX upload support"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\Typo3AiChat\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\Typo3AiChat\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "captainhook": {
            "config": "Build/captainhook.json"
        },
        "typo3/cms": {
            "extension-key": "webconsulting_ai_chat",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php .Build/bin/captainhook install --force --skip-existing -c Build/captainhook.json 2>/dev/null || true"
        ],
        "post-update-cmd": [
            "@php .Build/bin/captainhook install --force --skip-existing -c Build/captainhook.json 2>/dev/null || true"
        ],
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c Build/phpstan/phpstan.neon --no-progress --memory-limit=1G",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml",
        "ci:tests:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml --testsuite unit",
        "ci:tests:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml --testsuite functional",
        "ci:tests:architecture": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit.xml --testsuite architecture",
        "ci:mutation": ".Build/bin/infection --configuration=infection.json.dist --threads=4 --no-progress",
        "ci:mutation:ci": ".Build/bin/infection --configuration=infection.json.dist --threads=4 --no-progress --logger-github",
        "ci:rector": ".Build/bin/rector process --config Build/rector/rector.php --dry-run",
        "fix:cgl": ".Build/bin/php-cs-fixer fix",
        "rector": ".Build/bin/rector process --config Build/rector/rector.php"
    }
}
